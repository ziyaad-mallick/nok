{
  "default": {"action": "none", "args": {}, "say": "Sorry, I didn't catch that."},
  "rules": [
    {"contains": "spotify", "response": {"action": "open_app", "args": {"name": "spotify"}, "say": "Opening Spotify."}},
    {"contains": "notepad", "response": {"action": "open_app", "args": {"name": "notepad"}, "say": "Opening Notepad."}},
    {"contains": "mute", "response": {"action": "media", "args": {"command": "mute"}, "say": "Muting."}},
    {"contains": "calculator", "response": {"action": "open_app", "args": {"name": "calculator"}, "say": "Opening Calculator."}},
    {"contains": "explorer", "response": {"action": "open_app", "args": {"name": "explorer"}, "say": "Opening File Explorer."}},
    {"contains": "files", "response": {"action": "open_app", "args": {"name": "explorer"}, "say": "Opening File Explorer."}},
    {"contains": "settings", "response": {"action": "open_app", "args": {"name": "settings"}, "say": "Opening Settings."}},
    {"contains": "youtube", "response": {"action": "open_app", "args": {"name": "youtube"}, "say": "Opening YouTube."}},
    {"contains": "gmail", "response": {"action": "open_app", "args": {"name": "gmail"}, "say": "Opening Gmail."}},
    {"contains": "email", "response": {"action": "open_app", "args": {"name": "email"}, "say": "Opening your email."}},
    {"contains": "maps", "response": {"action": "open_app", "args": {"name": "maps"}, "say": "Opening Maps."}},
    {"contains": "google", "response": {"action": "open_app", "args": {"name": "google"}, "say": "Opening Google."}},
    {"contains": "focus", "response": {"action": "macro", "args": {"name": "focus"}, "say": "Focus mode."}},
    {"contains": "__prose__", "mode": "prose", "response": {"action": "media", "args": {"command": "pause"}, "say": "Pausing."}},
    {"contains": "__nojson__", "mode": "no_json"},
    {"contains": "__timeout__", "mode": "timeout"},
    {"contains": "__quota__", "mode": "quota"}
  ]
}
